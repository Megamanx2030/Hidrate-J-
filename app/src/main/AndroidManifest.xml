<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        SCHEDULE_EXACT_ALARM sozinha, sem a USE_EXACT_ALARM.

        As duas dao o mesmo poder de agendar no horario exato. A diferenca e
        quem autoriza: a USE_EXACT_ALARM ja vem concedida, mas a Play Store so
        aceita ela em app de despertador, timer ou calendario. Lembrete de
        agua e zona cinzenta e o Google ja recusou casos parecidos. A
        SCHEDULE_EXACT_ALARM nao pede formulario nenhum; em troca, o usuario
        concede na mao.

        O custo e um toque a mais na instalacao, e o app ja sabe pedir: veja
        AlarmPermissionHelper.canScheduleExactAlarms e o aviso da MainActivity.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- NOVO: necessario para tocar o alarme por 10s com o app fechado.
         SHORT_SERVICE e o tipo desenhado para trabalho curto e critico
         que nao pode ser adiado (ate ~3 min). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <!-- NOVO: e o que faz a tela azul aparecer com o celular DESBLOQUEADO.
         Comprovado em logcat (08/2026, moto g56, Android 16): sem ela o
         Android recusa o startActivity vindo do alarme com
         "Background activity launch blocked" e resultIfPiCreatorAllowsBal=
         BAL_BLOCK, ou seja, a isencao do setAlarmClock nao valeu neste
         aparelho. Ter SYSTEM_ALERT_WINDOW e uma isencao de BAL do proprio
         AOSP, entao o fabricante nao tem como barrar.
         O usuario concede na mao; sem ela o app continua funcionando,
         so que a tela azul fica restrita ao celular bloqueado. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        REMOVIDA a REQUEST_IGNORE_BATTERY_OPTIMIZATIONS.

        A politica da Play so aceita ela quando o app deixa de funcionar sem a
        isencao: saude em tempo real, navegacao, chamadas. Lembrete de agua
        nao entra nessa lista, e o proprio lint do Android acusava a violacao.

        A FUNCAO CONTINUA. O que muda e o caminho: em vez do atalho que pede a
        isencao direto (e que exige a permissao declarada), o app agora abre a
        LISTA de otimizacao de bateria do sistema, onde a pessoa acha o
        "Hidrate Ja" e marca "Nao otimizar". Essa tela nao exige permissao
        nenhuma. Ver AlarmPermissionHelper.abrirListaDeOtimizacaoDeBateria.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- MUDOU: launchMode singleTask garante que o intent do alarme chegue
             na Activity existente (onNewIntent) em vez de recriar do zero.
             showWhenLocked/turnScreenOn precisam estar AQUI, nao so no onCreate:
             o sistema le isso antes de criar a Activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.HidrateJa.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NOVO: servico em primeiro plano que toca o som/vibracao.
             Sem isso o processo morre no meio dos 10 segundos. -->
        <service
            android:name=".alarm.WaterAlarmService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <receiver
            android:name=".alarm.WaterReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.BootCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
