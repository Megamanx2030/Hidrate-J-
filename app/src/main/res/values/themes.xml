<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />
    
    <!--
        O splash do sistema agora e so o fundo azul, sem icone: quem mostra a
        marca e a AberturaAnimada, em Compose, com a jarra grande e a agua
        subindo. O fundo aqui e EXATAMENTE a mesma cor do FundoAbertura
        (Color(0xFFB4E4F3)) para a troca das duas telas nao piscar.
    -->
    <style name="Theme.HidrateJa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#B4E4F3</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/abertura_sem_icone</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
