<?xml version="1.0" encoding="utf-8"?>
<!--
    Icone da notificacao, o que aparece na barra de status.

    Estava usando android.R.drawable.ic_popup_reminder, que e o SININHO do
    proprio Android: a marca do app e uma jarra com copo, e na barra de status
    ela aparecia como qualquer outro app de lembrete.

    REGRAS DA BARRA DE STATUS, que mandam neste desenho:
    o Android joga fora a cor e usa so o formato, pintando tudo de branco (ou
    preto, conforme o tema). Por isso aqui e tudo silhueta cheia, sem contorno
    fino: em 24dp um traco de 1px some. Pelo mesmo motivo a jarra e o copo tem
    uma folga entre eles, senao viram um borrao unico.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Copo, na frente e a esquerda -->
    <path
        android:pathData="M2.6,11 L8.1,11 L7.45,20.2 C7.42,20.65 7.05,21 6.6,21 L4.1,21 C3.65,21 3.28,20.65 3.25,20.2 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Jarra: corpo e bico, numa figura so -->
    <path
        android:pathData="M9.7,5.2 L7.5,6.5 L9.9,7.7 L9.7,5.2 M9.7,5.2 L19.4,5.2 C20.3,9.5 20.6,14.5 19.5,17.8 C19,19.6 17.6,21 15.7,21 L13.3,21 C11.4,21 10.4,19.6 10,17.8 C9,14.5 8.9,9.5 9.7,5.2 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Asa -->
    <path
        android:pathData="M19.9,7.4 C22.4,8 23.2,10.5 22.6,12.6 C22.1,14.3 21,15.2 19.9,15.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
