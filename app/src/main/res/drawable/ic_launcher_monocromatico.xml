<?xml version="1.0" encoding="utf-8"?>
<!--
    Icone monocromatico (icone com tema, Android 13+).

    O monochrome apontava para a mesma FOTO do ic_launcher_foreground. Foto
    nao serve aqui: o sistema joga fora a cor e pinta tudo com uma cor so, entao
    a jarra virava um borrao solido. Este desenho e vetorial e so tem o contorno
    da jarra, do copo e da agua, que e o que continua legivel depois de
    pintado de uma cor unica.

    Medidas em 108dp para bater com as camadas do icone adaptativo; o desenho
    fica dentro dos 72dp centrais, que e a unica area que o launcher garante.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Jarra: bico, corpo e base -->
    <path
        android:pathData="M47,32 L42,34 L46,37 M47,32 L77,32 C80,45 81,59 77,70 C75,77 69,81 62,81 C55,81 49,77 47,70 C43,59 44,45 47,32 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Asa da jarra -->
    <path
        android:pathData="M79,40 C87,42 90,50 88,57 C86,63 82,66 78,67"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
