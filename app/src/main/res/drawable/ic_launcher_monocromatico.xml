    <!-- Agua dentro da jarra, com a onda -->
    <path
        android:pathData="M45.4,53 C49,50 53,56 57,53 C61,50 65,56 69,53 C72,51 75,52 78.4,53 C78.6,60 78,66 76,70 C74,76 69,79 62,79 C55,79 50,76 48,70 C46,66 45.2,60 45.4,53 Z"
