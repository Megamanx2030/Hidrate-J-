# MODELO. O arquivo de verdade chama-se keystore.properties, fica ao lado deste
# e NAO vai para o git (esta no .gitignore).
#
# Copie este arquivo para keystore.properties e preencha com os seus dados.
# O caminho do keystore e absoluto de proposito: o arquivo .jks mora FORA do
# repositorio, para nunca ser enviado ao GitHub por engano.

storeFile=C:\\Users\\SEU-USUARIO\\Documents\\HidrateJa-chaves\\hidrateja-upload.jks
storePassword=a-senha-do-keystore
keyAlias=upload
keyPassword=a-senha-da-chave
